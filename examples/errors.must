// This file is intentionally broken: every item below trips exactly one
// diagnostic, meant to be read next to `must-lsp check`'s output.
//
// Run: must-lsp check examples/errors.must
//
// Each comment quotes the diagnostic's headline (the message text; not the
// source spans, which shift with the file). The real command prints more
// than that — a `-->` location, a source snippet, related notes, and
// several `= help:` quick fixes — pasted in full in the accompanying
// report.
//
// `must-lsp check examples/errors.must` reports, at the time of writing,
// exactly: found 40 errors and 1 warning.

// 1. Type mismatch, with the annotation blamed as the cause.
//    error: type mismatch: expected `usize`, found `str`
static bad_annotation: usize = "not a number";

// 2. Const-context violation: every item initializer is a const context,
//    and `double` is a plain `fn`, not a `const fn`, so calling it here is
//    rejected — conservatively; being *provably* pure isn't enough, only a
//    `const fn` literal or a name resolving to one is visibly callable.
//    error: cannot call `double` in a const context; marking it `const fn` would allow this
//    quick fix offered: "Mark `double` as `const fn`" (inserts `const `
//    right before `double`'s `fn` keyword, which is the actual fix here).
static double = fn (n: usize) -> usize { n * 2 };
static const_violation = double(21);

type Shape = enum { Circle(usize), Point };

// 3. Non-exhaustive match: `Shape` has two variants, this arm list covers
//    only one — the `match` keyword itself is squiggled, naming what's left.
//    error: this `match` does not cover `Shape::Point`
static describe_shape = fn (s: Shape) -> str {
    match s {
        ::Circle(r) => "circle",
    }
};

// 4. Assignment to an immutable binding: `let` (no `mut`) means no further
//    writes.
//    error: cannot assign to `x`: it is not declared `mut`
static reassign_immutable = fn () -> usize {
    let x: usize = 1;
    x = 2;
    x
};

// 5. Missing record field: the annotation demands `y`, the literal never
//    supplies it.
//    error: record literal is missing field `y: str`
static missing_field: struct { x: usize, y: str } = struct { x = 1 };

// 6. Variant demanded, enum given: `wants_circle` is typed to require the
//    precise `Shape::Circle` variant; a `Shape::Point` doesn't widen the
//    other way (widening only ever goes variant -> enum).
//    error: type mismatch: expected `Shape::Circle`, found `Shape::Point`
static wants_circle = fn (s: Shape::Circle) -> usize { 0 };
static call_with_wrong_variant = fn () -> usize { wants_circle(Shape::Point) };

// 7. Binding-shadows-variant: a bare name in pattern position always binds
//    the whole scrutinee, even when it spells a variant's name — well-typed
//    (a full catch-all), but almost always a migration mistake, so it warns
//    instead of silently reinterpreting.
//    warning: `Point` binds the whole value; write `::Point` (or `Shape::Point`) to match the variant
static shadow_variant = fn (s: Shape) -> str {
    match s {
        ::Circle(r) => "circle",
        Point => "point",
    }
};

// 8. Rigid-parameter misuse: inside a generic body a type param `T`
//    unifies only with itself, so `x + 1` is rejected the same way it
//    would be for any other non-integer type — no caller's instantiation
//    ever makes `T` support an operation the body wasn't checked against.
//    (See `generics.must` for what a rigid `T` *does* support.)
//    Two parameters, and the one that comes back is not the one the
//    arithmetic reads: a parameter nobody constrained may be a type that
//    must be consumed, so each has to go somewhere exactly once. No bound
//    is needed for that, and none would help — `T: forget` says a value
//    may be DISCARDED, which is not the same question as whether it may be
//    read twice.
//    error: type mismatch: expected `{number}`, found `T`
static rigid_add_one = fn::<T>(x: T, y: T) -> T {
    let n = x + 1;
    y
};

// 9. Compile-time out-of-bounds: an array length is part of its type, so an
//    index the checker can evaluate is checked right then — no need to run
//    anything. The *same* message is what a genuinely runtime-only index
//    traps with (`must-lsp run` on a dynamic OOB prints it verbatim); the
//    length just lets the checker reach it early here.
//    error: index out of bounds: the length is 2 but the index is 2
static compile_time_oob = fn () -> usize {
    let a = [1, 2];
    a[2]
};

// 10. Deref outside `unsafe`: forming a pointer is safe, but *following* one
//     — reading or writing `p.*` — must sit inside an `unsafe { ... }` block.
//     There is no auto-deref, so this is the only way `p.*` ever appears.
//     error: dereferencing a raw pointer requires an `unsafe { ... }` block
static deref_outside_unsafe = fn () -> usize {
    let mut x = 1;
    let p = x.&raw mut;
    p.*
};

// 11. `.&raw mut` of a non-`mut` root: a mutating pointer may only be taken
//     to something already assignable, so the mut-root rule blames the
//     binding and offers the same "make it `mut`" quick fix an assignment
//     would.
//     error: cannot take `.&raw mut` of `x`: it is not declared `mut`
//     quick fix offered: "Make `x` mutable"
static addr_of_non_mut = fn () {
    let x: usize = 1;
    print("hello");
    let p = x.&raw mut;
};

// 12. Const-param length mismatch: `Buf::<8>` and `Buf::<9>` are distinct
//     types — the const argument is checked, not decorative — so a `Buf::<9>`
//     value does not satisfy a `Buf::<8>` annotation.
//     error: type mismatch: expected `Buf::<8>`, found `Buf::<9>`
type Buf = struct::<const N: usize> { len: usize };
static wrong_const_len: Buf::<8> = Buf::<9>(struct { len = 1 });

// 13. A pointer escaping compile-time evaluation: pointers hold no stable
//     identity beyond the frame that owns their pointee, so one can never be
//     the *result* of const evaluation — a static's value would outlive the
//     frame it points into. The whole initializer is a const context, so
//     the block yielding `x.&raw mut` is rejected.
//     error: constant evaluation failed: a pointer cannot leave compile-time evaluation
static pointer_escaping_const = const {
    let mut x: usize = 1;
    x.&raw mut
};

// 14. A number with no defining use: an integer literal's type is entirely
//     inferred — an annotation, a parameter type, an index position, or an
//     already-typed operand pins it — and NEVER defaulted. Nothing here says
//     what `5` is, so the literal itself is the error.
//     error: cannot infer the type of this number: it has no defining use — add a type annotation
static ambiguous_number = fn () -> () {
    let n = 5;
};

// 15. A literal outside its type's range: the defining use (the `u8`
//     annotation) resolves the literal's type, and the value is then
//     range-checked right there — `300` needs more than 8 bits.
//     error: `300` does not fit in `u8`
static too_big_for_u8: u8 = 300;

// 16. The retired construction spelling: record fields are DEFINED with
//     `=` (`name = value`); after a `:` comes a type, uniformly — the old
//     `name: value` form is a targeted parse error, never a silent
//     reinterpretation.
//     error: record fields are defined with `=` (`name = value`); `:` annotates a type
static old_spelling: struct { x: usize } = struct { x: 1 };

// 17. A trait-side `impl` names a trait that doesn't exist: the sealed
//     grammar parses it whole (element boundaries are token-recognizable),
//     but the impl needs an actual `trait` declaration to attach to.
//     error: unknown trait `Display`
type Reserved = struct { n: usize } with {
    impl Display {
        fmt = fn(r: Self) -> str { "reserved" };
    }
};

// 18. A colon-declared member inside `impl Self` is an unimplementable
//     promise: an inherent impl is the only impl site its type will ever
//     have, so a declaration with no definition can never be satisfied.
//     error: a declare-only inherent member is an unimplementable promise; define it: `name = fn(...) -> ... { ... };`
type Promised = struct { n: usize } with {
    impl Self {
        len: fn(p: Self) -> usize;
    }
};

// 19. Module-level statics are never dot-callable — G13's deliberate
//     opt-out: identical signature, but only members resolve through the dot.
//     The related note points at `plain_len` and says to call it directly.
//     error: no field or member `plain_len` on `Opted`
type Opted = struct { n: usize };
static plain_len = fn (o: Opted) -> usize { o.n };
static dotted_call = fn (o: Opted) -> usize { o.plain_len() };

// 20. A member whose LAST parameter is neither `Self` nor a safe borrow of
//     `Self` is not dot-callable: resolution is structural — the receiver
//     becomes the last argument, so only those two shapes receive it.
//     error: `scaled` is not dot-callable: its last parameter is neither `Self` nor a safe borrow of `Self` (dot-call resolution is structural)
type Scaler = struct { n: usize } with {
    impl Self {
        scaled = fn(s: Self, by: usize) -> usize { s.n * by };
    }
};
static wrong_self_position = fn (s: Scaler) -> usize { s.scaled(2) };

// 21. The retired PREFIX raw-borrow spelling: raw borrows (and raw pointer
//     types) are now postfix — the dual of `.*` — so `&raw x` / `&raw mut x`
//     get a targeted migration diagnostic rather than a silent
//     reinterpretation. The postfix form is `x.&raw` / `x.&raw mut`.
//     error: raw borrows are spelled postfix: `x.&raw` / `x.&raw mut`
static retired_prefix_raw = fn () -> () {
    let mut x: usize = 1;
    let p = &raw mut x;
    unsafe { p.* = 2; };
};

// 22. `return` inside a `const { ... }` block: what it should mean is
//     leaving the enclosing function, but a `const` block is compiled as a
//     body of its own, so carrying the exit across that boundary needs
//     machinery that does not exist yet. Refused rather than given the
//     other (reachable but wrong) reading.
//     error: `return` inside a `const` block is not supported yet: it would have to leave the enclosing `fn` body, and a `const` block is compiled as a body of its own
static return_in_const_block = fn () -> usize {
    const { if true { return 1; }; 0 }
};

// 23. A turbofish on a qualified member's OWN name, where the member has
//     no binder of its own. A member MAY bind type parameters now
//     (`map = fn::<U>(...)`), so this list is spendable in principle — it
//     is this particular member that takes nothing, and the message is the
//     one every binder-less turbofish gets. A member's REGIONS are not
//     positions in the list (they are always inferred; see 28 below), so
//     `size` would still take none even if it declared one. (On a VARIANT
//     the same shape gets a different answer: a variant never gets a
//     binder, so its arguments are the owner's, misplaced —
//     `Shape::<usize>::Circle`.)
//     error: `Measured::size` takes no generic arguments
type Measured = struct { n: usize } with {
    impl Self {
        size = fn (m: Self) -> usize { m.n };
    }
};
static member_own_turbofish = fn () -> () { let f = Measured::size::<usize>; };

// 23b. The one member-argument RESERVATION that is left: a CONST parameter
//     of a member's own. It needs a trait requirement to reach — an
//     inherent member cannot declare one at all (that is a parse-time
//     refusal, not this) — and the whole list is refused rather than
//     spent in part. The ground is instance identity: a const argument is
//     part of WHICH instance is called, and a member's arguments are read
//     off the receiver's own type, which cannot supply one.
//     error: `Counted::step` declares a const parameter of its own, and const member arguments are not supported yet (a member's type arguments are written here; its region arguments are always inferred)
trait Counted = requires { step: fn::<const N: usize>(s: Self) -> usize; } with {
    impl usize { step = fn::<const N: usize>(s: usize) -> usize { N }; }
};
static member_own_const_turbofish = fn (n: usize) -> usize { Counted::step::<3>(n) };

// 24. A qualified path naming a FIELD: the field/member namespace split
//     puts fields on VALUES and members on the type, so `Sized::len` is
//     looking in the wrong namespace — not at nothing. The message says
//     which namespace the name IS in, and how to reach it.
//     error: `len` is a field of `Sized`, not a member — fields are reached through a value: `value.len`
type Sized = struct { len: usize };
static field_through_the_type = fn () -> () { let n = Sized::len; };

// 25. `Self = _` on a qualified trait path: `Self` NAMES the implementer —
//     it is what decides which impl the path denotes — so a hole there
//     declines to answer the only question the spelling asks. Refused
//     structurally, so no inference variable ever reaches trait resolution
//     (or a message).
//     error: `Self` names the implementer, so it cannot be `_`: write the type (`Trait::<Self = Type>::member`), or use the short form `Trait::member(...)` where an argument determines `Self`
trait Countable = requires {
    count: fn (c: Self) -> usize;
} with {
    impl usize { count = fn (c: usize) -> usize { c }; }
};
static self_hole = fn (n: usize) -> usize { Countable::<Self = _>::count(n) };

// 26. An OUTLIVES violation. Returning `x` at `@b` asks `@a` — the region
//     the caller gave the argument — to cover `@b`, which the signature
//     never promised. Both regions are parameters, so the compiler cannot
//     pick between them: only the caller knows which is longer, and the
//     signature is where they are told. Adding `@a: @b` to the binder is
//     the fix, and it is exactly what the message says.
//     error: using this borrow where a longer-lived one is expected needs `@a` to outlive `@b`, which this signature does not declare; add `@a: @b` to the binder
static undeclared_outlives = fn::<@a, @b>(x: usize.&::<@a>) -> usize.&::<@b> { x };

// 27. `::Variant` in EXPRESSION position with no enum in view. The sigil
//     is the mirror of the variant PATTERN's: the pattern reads the
//     scrutinee's enum, the expression reads the position's expected type.
//     Here the `let` has no annotation, so there is no expected type to
//     read — and rather than inferring one backwards, it refuses and names
//     the qualified spelling, which is always available and stays the
//     canonical one. Sugar that only ever removes a rejection.
//     error: cannot resolve `::Point` without an expected type — write `Enum::Point`
static sigil_without_a_type = fn () -> () { let s = ::Point; };

// 28. A dot-call whose member takes a BORROW of `Self`, on an OWNED
//     receiver. This is NOT auto-ref, and the reason is a rule, not an
//     omission: the borrow the compiler would have to insert is a borrow
//     of the LOCAL `c` itself, and the one licensed insertion is a borrow
//     of `x.*` where `x` is ALREADY a borrow. So the borrow is written —
//     and `c.&mut.bump()` is an ordinary postfix chain whose receiver is
//     then a borrow, which is the licensed case.
//     error: `bump` takes `Self.&mut`, and a borrow is never inserted for an owned receiver — write `.&mut.bump(...)`
type Counter = struct { n: usize } with {
    impl Self {
        bump = fn::<@b>(m: Self.&mut::<@b>) -> () { m.*.n = m.*.n + 1; };
    }
};
static owned_receiver = fn () -> () {
    let mut c = Counter(struct { n = 1 });
    c.bump()
};

// 29. The bare-angle generics typo. `::<...>` applies generic arguments
//     everywhere, so `Boxed<usize>` is a permanent mistake rather than a
//     form waiting to be granted — the parser reads it as the turbofish it
//     plainly means (the arguments are checked exactly as `Boxed::<usize>`'s
//     are) and the diagnostic names the missing `::`.
//     error: generic arguments use the turbofish: write `Boxed::<...>`
//     quick fix offered: "Insert `::`"
type Boxed = struct::<T> { value: T };
static bare_angle_generics = fn (b: Boxed<usize>) -> usize { b.value };

// 30. Const-context violation, `read_line`'s turn: every item initializer
//     is a const context, and `read_line` is a side-effecting builtin
//     (the stdin hook, `print`'s input twin) — const evaluation cannot
//     have side effects, so calling it here is rejected the same way
//     `print` would be (see `examples/stdin.must`).
//     error: cannot call `read_line` in a const context; const evaluation cannot have side effects
static read_line_in_const = read_line();

// 31. The retired PREFIX safe-borrow spelling: safe borrows (like raw ones,
//     21 above) are postfix — `x.&` / `x.&mut` — so a bare `&x` / `&mut x`
//     gets a targeted migration diagnostic rather than a silent
//     reinterpretation, with a fix that rewrites it.
//     error: borrows are spelled postfix: `x.&` / `x.&mut`
static retired_prefix_borrow = fn () -> () {
    let x: usize = 1;
    let r = &x;
};

// 32. A host import called without the marker. An `extern static` declares
//     a call OUT of the program, and what it does is written in a language
//     this compiler never sees — so nothing on this side can establish that
//     the call is sound, and the caller vouches with `unsafe` exactly as it
//     does for a raw-pointer deref (21 above).
//     error: calling the host import `host_read` requires an `unsafe { ... }` block; nothing on this side of the boundary can check what it does
extern static host_read: unsafe fn(buf: u8.&raw mut, len: usize) -> isize;
static unvouched_import = fn (p: u8.&raw mut) -> isize { host_read(p, 8) };

// 33. The retired INITIALIZER spelling of an import. An import sets nothing
//     to anything, so it is written as the declaration it is; the old form
//     put an `=` in front of something that is not a value. Like the prefix
//     borrow (31 above) it still parses and still means the same import —
//     retiring a spelling must not reinterpret programs written in it — and
//     a fix rewrites it.
//     error: a host import is a DECLARATION, not an initializer: write `extern static retired_import: unsafe fn(...) -> T;`
//     quick fix offered: "Rewrite as an `extern static` declaration"
static retired_import = extern fn(n: usize) -> usize;

// 34. An initializer on an `extern static`. The declaration is the whole
//     contract — the item's name is the name the host is asked for and the
//     annotation is the one machine signature it must provide — so there is
//     nothing left to set. The value wins where one is written (this item
//     is NOT an import), and the fix cuts the value, not the contract.
//     error: an `extern static` has no initializer: the declaration is the whole contract, and an import sets nothing to anything
//     quick fix offered: "Remove the initializer"
extern static import_with_a_value: unsafe fn(n: usize) -> usize = fn (n: usize) -> usize { n };

// 35. An import declared safe to call. Two things are unsafe about a
//     boundary and only one of them has a spelling: DECLARING the signature
//     is already a vouch nothing on this side can check, while CALLING is
//     priced per function by its type. A safe-to-call import is a real
//     shape, blocked on the declaration-side marker rather than rejected —
//     so the `unsafe` is required for now, and the fix writes it.
//     error: an import must be declared `unsafe fn` for now: a safe-to-call import needs the declaration-side `unsafe` marker, and that marker does not exist yet
//     quick fix offered: "Write `unsafe fn`"
extern static safe_import: fn() -> ();

// 36. A DATA import. The spelling admits it — an annotation is an
//     annotation — but a function import's price rides its TYPE, and there
//     is no `unsafe usize` for a data import's to ride. Reserved rather
//     than guessed at, so granting it later deletes a diagnostic instead of
//     inventing a syntax.
//     error: data imports are not supported yet — an import must have a function type
extern static a_data_import: usize;

// 37. A hole in an import's contract. `_` names a type the BODY
//     determines, and an import has no body — the declaration is the whole
//     contract, so a piece of it left unwritten is unwritten for good.
//     Refused once per hole, wherever in the signature it stands.
//     error: an import's type must be written in full: the declaration is the whole contract, and there is no body for `_` to be inferred from
extern static a_partial_contract: unsafe fn(n: _) -> i64;

// 38. A region written at a CALL SITE. Regions are elided at every call:
//     a written turbofish spells the callee's type and const arguments
//     only, and the callee's regions become fresh existentials of this
//     call, solved from the arguments actually passed. Named or wildcard,
//     the region is refused one argument at a time, so `usize` still
//     counts and the call is otherwise checked (see 23 above: a member's
//     list gets the same sentence).
//     error: regions are inferred at calls, never written: drop this argument — a turbofish spells type and const arguments only
static first = fn::<@a, T>(r: T.&::<@a>) -> T.&::<@a> { r };
static region_at_a_call = fn::<@b>(p: usize.&::<@b>) -> usize { first::<@b, usize>(p).* };

// 39. A region parameter AFTER a type parameter in a binder. Regions come
//     first (`fn::<@a, T>`): a turbofish spells the binder minus its
//     regions, and that subtraction only reads correctly when the elided
//     part is a contiguous prefix. Checking itself does not need the
//     order, so the binder still works as declared.
//     error: region parameters come first in a binder; move `@a` before `T`
static misordered_binder = fn::<T, @a>(r: T.&::<@a>) -> T.&::<@a> { r };

// 40. A region written on a BORROW expression. Regions are written only in
//     type positions, and a borrow is an operation: its region is inferred,
//     and a body that wants to pin one says so in an annotation
//     (`let q: _.&::<@c> = p.*.&;`). Named or wildcard, the whole list is
//     refused, and the fix drops it.
//     error: regions are inferred at a borrow, never written: drop this argument — a region belongs in a type position, so assert it with an annotation (`let r: _.&::<@a> = x.&;`)
//     quick fix offered: "Drop the region argument"
static region_at_a_borrow = fn::<@c>(p: usize.&::<@c>) -> usize { let q = p.*.&::<@c>; q.* };
