// Safe borrows and regions.
//
// Run: must-lsp run examples/borrows.must
//
// A borrow is spelled POSTFIX, like every other place adaptor: `x.&` is a
// shared borrow, `x.&mut` an exclusive one, and `r.*` reads through either.
// Deref of a borrow needs no `unsafe` — safety is decided by the pointer's
// FLAVOR, and `.&raw` is the unsafe flavor.
//
// Every borrow says how long it is good for: its REGION, spelled `@a` and
// carried on the borrow operator's own turbofish. Regions ride the same
// binder list as type and const parameters (`fn::<@a, T, const N>`) but are
// a distinguished kind — they are erased before anything is compiled, so a
// region can reject a program and can never change what it does.
//
// Nothing is elided in a signature yet. Every region a signature binds is
// written out by hand, deliberately, until enough code exists to say which
// elision rule would have earned its keep. A CALL SITE is the opposite: it
// never spells a region — the callee's regions are inferred from the
// arguments passed, so a turbofish there spells type and const arguments
// only.

// ---- shared borrows -----------------------------------------------------

// `@a` is a parameter of this function, exactly like `T` would be: the
// CALLER picks it, and the body is checked against whatever they pick.
static get = fn::<@a>(r: usize.&::<@a>) -> usize {
    // Safe `.*`. `usize` is copyable, so reading the referent copies it.
    r.*
};

static sum_of = fn::<@a, @b>(x: usize.&::<@a>, y: usize.&::<@b>) -> usize {
    x.* + y.*
};

// ---- exclusive borrows --------------------------------------------------

static bump = fn::<@a>(m: usize.&mut::<@a>) -> () {
    m.* = m.* + 1;
};

static set_to = fn::<@a>(m: usize.&mut::<@a>, v: usize) -> () {
    m.* = v;
};

// ---- degradation: `.&mut` where a `.&` is wanted ------------------------
//
// An exclusive borrow may be used where a shared one is expected. It is not
// subtyping — a callee could stash a shared reference for the whole of the
// parent's region — so what actually happens is a shared REBORROW: the
// region shrinks and the parent is suspended for its span. Nothing is
// written at the use site; the checker inserts it.
static read_through_mut = fn::<@a>(m: usize.&mut::<@a>) -> usize {
    get(m)
};

// ---- reborrow at every use ----------------------------------------------
//
// A `.&mut` value is AFFINE: it cannot be duplicated, because duplicating it
// would duplicate a permission. What repeats is PROJECTION through the place
// holding it — every mention in a position that WANTS a borrow mints a
// fresh, shorter-lived reborrow with the parent suspended for exactly that
// reborrow's region.
//
// So `m` below is passed to a function twice and then used again. In a
// language that moved on the first use this would not compile.
//
// The qualifier is load-bearing: read into a position with no borrow-typed
// expectation (`let c = m;`) the borrow is copied verbatim, and neither the
// checker nor the interpreter sees the duplication. The manual lists that
// as the fourth limit of the backstop.
static bump_twice = fn::<@a>(m: usize.&mut::<@a>) -> usize {
    bump(m);
    bump(m);
    m.*
};

// ---- outlives clauses ---------------------------------------------------
//
// Returning a borrow at a region the caller chose means promising the value
// lives that long. When one region has to cover another, the signature says
// so — `@a: @b` reads "`@a` outlives `@b`". Without the clause this is
// rejected; `examples/errors.must` shows exactly that rejection.
static longer = fn::<@a: @b, @b>(x: usize.&::<@a>) -> usize.&::<@b> {
    x
};

// ---- borrowing through a borrow -----------------------------------------
//
// `m.*` is a place, so it can be borrowed again. The child's region is
// shorter than the parent's and the parent is suspended while the child
// lives — which is the same reborrow the calls above perform implicitly,
// written out.
static through = fn::<@a>(m: usize.&mut::<@a>) -> usize {
    let inner = m.*.&mut;
    set_to(inner, 40);
    m.*
};

// ---- disjoint fields borrow independently -------------------------------
//
// A borrow is minted over a PLACE, and two places naming disjoint parts of
// one value never conflict: `p.x.&mut` and `p.y.&mut` are live at the same
// time, and reading or writing one field does not disturb a borrow of the
// other. Only overlapping places interact — a borrow of the whole `p` would
// dominate both fields.
static fields = fn () -> usize {
    let mut p: struct { x: usize, y: usize } = struct { x = 0, y = 0 };
    let bx = p.x.&mut;
    let by = p.y.&mut;
    // Both are live at once, because `p.x` and `p.y` are disjoint places.
    set_to(bx, 1);
    set_to(by, 2);
    // A sibling READ is disjoint in the same way: reading `p.y` does not
    // suspend a borrow of `p.x`, so `bx` is still good right after it.
    let v = p.y;
    set_to(bx, v + 1);
    p.x
};

// ---- joins: a branch is a use site like any other -----------------------
//
// Each branch REBORROWS into the result, so two unrelated regions join
// without demanding any relation between them, and the result is good for
// as long as both branches are — their meet. A `.&mut` branch degrades into
// a shared context here exactly as it would at a direct call.
static pick = fn::<@a, @b>(x: usize.&::<@a>, y: usize.&::<@b>, c: bool) -> usize {
    get(if c { x } else { y })
};

static pick_flavors = fn::<@a>(x: usize.&::<@a>, m: usize.&mut::<@a>, c: bool) -> usize {
    get(if c { x } else { m })
};

static main = fn () -> () {
    let mut n: usize = 1;

    // A shared borrow of a local. Its region is inferred: inside a body
    // regions are inference variables, not parameters, so there is nothing
    // to name (and `@_` says so explicitly where an annotation is wanted).
    print_usize(get(n.&));

    // An exclusive borrow, used repeatedly through reborrows.
    print_usize(bump_twice(n.&mut));

    // Degradation in action: an exclusive borrow read through a shared
    // parameter.
    print_usize(read_through_mut(n.&mut));

    // A borrow reborrowed one level down.
    print_usize(through(n.&mut));

    // Two shared borrows of the same place, live at once — the shared
    // regime allows any number of them.
    let a = n.&;
    let b = n.&;
    print_usize(sum_of(a, b));

    // A body-local annotation naming its region explicitly with the
    // wildcard. `@_` is legal here and illegal in a signature, and that
    // asymmetry is the whole distinction between the two populations of
    // region.
    let r: usize.&::<@_> = n.&;
    print_usize(get(longer(r)));

    // A join over two borrows, and a join over two FLAVORS. The exclusive
    // borrow is of a DIFFERENT local — borrowing `n` both ways at once is
    // exactly the exclusivity violation the interpreter detects; static
    // loan liveness would reject it too, once it lands.
    print_usize(pick(n.&, n.&, true));
    let mut other: usize = 80;
    print_usize(pick_flavors(n.&, other.&mut, true));

    // Two fields of one struct, borrowed at once.
    print_usize(fields());
};

// The language has no integer formatting yet and `print` takes a `str`, so
// the example names the handful of values it actually produces rather than
// pulling in `display.must`'s whole Write/Display machinery.
static print_usize = fn (n: usize) -> () {
    print(name_of(n));
};

static name_of = fn (n: usize) -> str {
    if n == 1 { "1" }
    else { if n == 3 { "3" }
    else { if n == 40 { "40" }
    else { if n == 80 { "80" }
    else { "?" } } } }
};
