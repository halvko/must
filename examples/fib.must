// Tree-recursive Fibonacci. There are no loops in Must, so recursion is
// the way. Depth is O(n), comfortably below the interpreter's stack limit.
//
// Run: must-lsp run examples/fib.must -e 'fib(20)'    (=> 6765)

static fib: fn(usize) -> usize = fn(n: usize) -> usize {
    if n < 2 {
        n
    } else {
        fib(n - 1) + fib(n - 2)
    }
}
