// This file is intentionally broken: every item below trips exactly one
// diagnostic, meant to be read next to `must-lsp check`'s output.
//
// Run: must-lsp check examples/errors.must
//
// Each comment quotes the diagnostic's headline (the message text; not the
// source spans, which shift with the file). The real command prints more
// than that — a `-->` location, a source snippet, related notes, and
// several `= help:` quick fixes — pasted in full in the accompanying
// report.
//
// `must-lsp check examples/errors.must` reports, at the time of writing,
// exactly: found 19 errors and 1 warning.

// 1. Type mismatch, with the annotation blamed as the cause.
//    error: type mismatch: expected `usize`, found `str`
static bad_annotation: usize = "not a number";

// 2. Const-context violation: every item initializer is a const context,
//    and `double` is a plain `fn`, not a `const fn`, so calling it here is
//    rejected — conservatively; being *provably* pure isn't enough, only a
//    `const fn` literal or a name resolving to one is visibly callable.
//    error: cannot call `double` in a const context; marking it `const fn` would allow this
//    quick fix offered: "Mark `double` as `const fn`" (inserts `const `
//    right before `double`'s `fn` keyword, which is the actual fix here).
static double = fn (n: usize) -> usize { n * 2 };
static const_violation = double(21);

type Shape = enum { Circle(usize), Point };

// 3. Non-exhaustive match: `Shape` has two variants, this arm list covers
//    only one — the `match` keyword itself is squiggled, naming what's left.
//    error: this `match` does not cover `Shape::Point`
static describe_shape = fn (s: Shape) -> str {
    match s {
        ::Circle(r) => "circle",
    }
};

// 4. Assignment to an immutable binding: `let` (no `mut`) means no further
//    writes.
//    error: cannot assign to `x`: it is not declared `mut`
static reassign_immutable = fn () -> usize {
    let x: usize = 1;
    x = 2;
    x
};

// 5. Missing record field: the annotation demands `y`, the literal never
//    supplies it.
//    error: record literal is missing field `y: str`
static missing_field: struct { x: usize, y: str } = struct { x = 1 };

// 6. Variant demanded, enum given: `wants_circle` is typed to require the
//    precise `Shape::Circle` variant; a `Shape::Point` doesn't widen the
//    other way (widening only ever goes variant -> enum).
//    error: type mismatch: expected `Shape::Circle`, found `Shape::Point`
static wants_circle = fn (s: Shape::Circle) -> usize { 0 };
static call_with_wrong_variant = fn () -> usize { wants_circle(Shape::Point) };

// 7. Binding-shadows-variant: a bare name in pattern position always binds
//    the whole scrutinee, even when it spells a variant's name — well-typed
//    (a full catch-all), but almost always a migration mistake, so it warns
//    instead of silently reinterpreting.
//    warning: `Point` binds the whole value; write `::Point` (or `Shape::Point`) to match the variant
static shadow_variant = fn (s: Shape) -> str {
    match s {
        ::Circle(r) => "circle",
        Point => "point",
    }
};

// 8. Rigid-parameter misuse: inside a generic body a type param `T`
//    unifies only with itself, so `x + 1` is rejected the same way it
//    would be for any other non-integer type — no caller's instantiation
//    ever makes `T` support an operation the body wasn't checked against.
//    (See `generics.must` for what a rigid `T` *does* support.)
//    error: type mismatch: expected `{number}`, found `T`
static rigid_add_one = fn::<T>(x: T) -> T {
    let y = x + 1;
    x
};

// 9. Compile-time out-of-bounds: an array length is part of its type, so an
//    index the checker can evaluate is checked right then — no need to run
//    anything. The *same* message is what a genuinely runtime-only index
//    traps with (`must-lsp run` on a dynamic OOB prints it verbatim); the
//    length just lets the checker reach it early here.
//    error: index out of bounds: the length is 2 but the index is 2
static compile_time_oob = fn () -> usize {
    let a = [1, 2];
    a[2]
};

// 10. Deref outside `unsafe`: forming a pointer is safe, but *following* one
//     — reading or writing `p.*` — must sit inside an `unsafe { ... }` block.
//     There is no auto-deref, so this is the only way `p.*` ever appears.
//     error: dereferencing a raw pointer requires an `unsafe { ... }` block
static deref_outside_unsafe = fn () -> usize {
    let mut x = 1;
    let p = &raw mut x;
    p.*
};

// 11. `&raw mut` of a non-`mut` root: a mutating pointer may only be taken
//     to something already assignable, so the mut-root rule blames the
//     binding and offers the same "make it `mut`" quick fix an assignment
//     would.
//     error: cannot take `&raw mut` of `x`: it is not declared `mut`
//     quick fix offered: "Make `x` mutable"
static addr_of_non_mut = fn () {
    let x: usize = 1;
    print("hello");
    let p = &raw mut x;
};

// 12. Const-param length mismatch: `Buf::<8>` and `Buf::<9>` are distinct
//     types — the const argument is checked, not decorative — so a `Buf::<9>`
//     value does not satisfy a `Buf::<8>` annotation.
//     error: type mismatch: expected `Buf::<8>`, found `Buf::<9>`
type Buf = struct::<const N: usize> { len: usize };
static wrong_const_len: Buf::<8> = Buf::<9>(struct { len = 1 });

// 13. A pointer escaping compile-time evaluation: pointers hold no stable
//     identity beyond the frame that owns their pointee, so one can never be
//     the *result* of const evaluation — a static's value would outlive the
//     frame it points into. The whole initializer is a const context, so
//     the block yielding `&raw mut x` is rejected.
//     error: constant evaluation failed: a pointer cannot leave compile-time evaluation
static pointer_escaping_const = const {
    let mut x: usize = 1;
    &raw mut x
};

// 14. A number with no defining use: an integer literal's type is entirely
//     inferred — an annotation, a parameter type, an index position, or an
//     already-typed operand pins it — and NEVER defaulted. Nothing here says
//     what `5` is, so the literal itself is the error.
//     error: cannot infer the type of this number: it has no defining use — add a type annotation
static ambiguous_number = fn () -> () {
    let n = 5;
};

// 15. A literal outside its type's range: the defining use (the `u8`
//     annotation) resolves the literal's type, and the value is then
//     range-checked right there — `300` needs more than 8 bits.
//     error: `300` does not fit in `u8`
static too_big_for_u8: u8 = 300;

// 16. The retired construction spelling: record fields are DEFINED with
//     `=` (`name = value`); after a `:` comes a type, uniformly — the old
//     `name: value` form is a targeted parse error, never a silent
//     reinterpretation.
//     error: record fields are defined with `=` (`name = value`); `:` annotates a type
static old_spelling: struct { x: usize } = struct { x: 1 };

// 17. Trait impls in a `with`-chain are parse-and-reserve: the sealed
//     grammar parses whole (element boundaries are token-recognizable),
//     but only `impl Self { ... }` inherent members are supported.
//     error: trait impls are not supported yet; only `impl Self { ... }` (inherent members) is
type Reserved = struct { n: usize } with {
    impl Display {
        fmt = fn(r: Self) -> str { "reserved" };
    }
};

// 18. A colon-declared member inside `impl Self` is an unimplementable
//     promise: an inherent impl is the only impl site its type will ever
//     have, so a declaration with no definition can never be satisfied.
//     error: a declare-only inherent member is an unimplementable promise; define it: `name = fn(...) -> ... { ... };`
type Promised = struct { n: usize } with {
    impl Self {
        len: fn(p: Self) -> usize;
    }
};

// 19. Module-level statics are never dot-callable — G13's deliberate
//     opt-out: identical signature, but only members resolve through the dot.
//     The related note points at `plain_len` and says to call it directly.
//     error: no field or member `plain_len` on `Opted`
type Opted = struct { n: usize };
static plain_len = fn (o: Opted) -> usize { o.n };
static dotted_call = fn (o: Opted) -> usize { o.plain_len() };

// 20. A member whose LAST parameter is not `Self`-typed is not dot-callable:
//     dot-call resolution is structural — the receiver becomes the last
//     argument, so only a Self-typed last parameter can receive it.
//     error: `scaled` is not dot-callable: its last parameter is not `Self`-typed (dot-call resolution is structural)
type Scaler = struct { n: usize } with {
    impl Self {
        scaled = fn(s: Self, by: usize) -> usize { s.n * by };
    }
};
static wrong_self_position = fn (s: Scaler) -> usize { s.scaled(2) };

