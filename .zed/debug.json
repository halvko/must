// Debug scenarios for `debugger: start` (F4). The Must adapter is the
// language server binary in dap mode — the program runs on the same
// interpreter the editor's analysis uses.
[
  {
    "label": "Run current Must file (main())",
    "adapter": "must",
    "request": "launch",
    "program": "$ZED_FILE"
  },
  {
    "label": "Run examples/fib.must: fib(20)",
    "adapter": "must",
    "request": "launch",
    "program": "$ZED_WORKTREE_ROOT/examples/fib.must",
    "entry": "fib(20)"
  }
]
